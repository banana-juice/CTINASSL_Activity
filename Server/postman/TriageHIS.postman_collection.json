{
  "info": {
    "name": "TriageHIS API (CTINASSL_Activity)",
    "_postman_id": "6c1d6b0e-1a4e-4d6f-9b8e-2f3c5a7d9e10",
    "description": "CRUD requests for the Express + MongoDB server. Start MongoDB and run `npm run dev` in Server first. Run the folders top to bottom (or use Collection Runner): Create saves the id used by the later requests.",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "item": [
    {
      "name": "Patients",
      "item": [
        {
          "name": "Create patient",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/patients/create",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "patients",
                "create"
              ]
            },
            "description": "Creates a patient. The server sets queueNo, status (Waiting) and arrivedAt. Saves the new id to {{patientId}}.",
            "body": {
              "mode": "raw",
              "raw": "{\n  \"name\": \"Juan Dela Cruz\",\n  \"age\": 45,\n  \"sex\": \"M\",\n  \"complaint\": \"Chest pain\",\n  \"level\": 2\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('Status is 201', () => pm.response.to.have.status(201));",
                  "const body = pm.response.json();",
                  "pm.test('Has queue number', () => pm.expect(body.patient.queueNo).to.match(/^Q-\\d{3}$/));",
                  "pm.collectionVariables.set('patientId', body.patient.id);"
                ]
              }
            }
          ]
        },
        {
          "name": "Get all patients",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/patients",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "patients"
              ]
            },
            "description": "Lists all patients, most urgent first."
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('Status is 200', () => pm.response.to.have.status(200));",
                  "pm.test('Returns a list', () => pm.expect(pm.response.json()).to.be.an('array'));"
                ]
              }
            }
          ]
        },
        {
          "name": "Get one patient",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/patients/{{patientId}}",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "patients",
                "{{patientId}}"
              ]
            },
            "description": "Gets the patient created above."
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('Status is 200', () => pm.response.to.have.status(200));"
                ]
              }
            }
          ]
        },
        {
          "name": "Update patient",
          "request": {
            "method": "PUT",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/patients/update/{{patientId}}",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "patients",
                "update",
                "{{patientId}}"
              ]
            },
            "description": "Updates only the fields you send: name, age, sex, complaint, level, status (Waiting | In assessment | Referred).",
            "body": {
              "mode": "raw",
              "raw": "{\n  \"level\": 1,\n  \"status\": \"In assessment\"\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('Status is 200', () => pm.response.to.have.status(200));",
                  "pm.test('Status updated', () => pm.expect(pm.response.json().patient.status).to.eql('In assessment'));"
                ]
              }
            }
          ]
        },
        {
          "name": "Create patient (invalid, expect 400)",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/patients/create",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "patients",
                "create"
              ]
            },
            "description": "Shows validation: sex must be F or M, level must be 1 to 5.",
            "body": {
              "mode": "raw",
              "raw": "{\n  \"name\": \"Bad Data\",\n  \"age\": 30,\n  \"sex\": \"X\",\n  \"complaint\": \"Test\",\n  \"level\": 9\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('Status is 400', () => pm.response.to.have.status(400));"
                ]
              }
            }
          ]
        },
        {
          "name": "Delete patient",
          "request": {
            "method": "DELETE",
